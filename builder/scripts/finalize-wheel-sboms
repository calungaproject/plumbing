#!/usr/bin/env python3
"""Synchronize the SPDX identity of the primary package's built wheels."""

from __future__ import annotations

import argparse
import sys
import zipfile
from email.parser import BytesParser
from pathlib import Path

from packaging.utils import canonicalize_name, parse_wheel_filename
from prune_wheel_sboms import PruneWheelSbomError, prune_wheel_sboms
from sync_wheel_sbom import SyncWheelSbomError, sync_wheel_sbom


class FinalizeWheelSbomsError(ValueError):
    """Raised when a version-overridden primary wheel cannot be finalized."""


def _identity(path: Path) -> tuple[str, str]:
    """Read the wheel's package identity from its single dist-info METADATA."""
    with zipfile.ZipFile(path) as wheel:
        members = [
            name for name in wheel.namelist() if name.endswith(".dist-info/METADATA")
        ]
        if len(members) != 1:
            raise FinalizeWheelSbomsError(
                f"expected one METADATA file in {path.name}, found {len(members)}"
            )
        metadata = BytesParser().parsebytes(wheel.read(members[0]))
        name, version = metadata.get("Name"), metadata.get("Version")
        if not name or not version:
            raise FinalizeWheelSbomsError(
                f"wheel {path.name} has incomplete Name/Version metadata"
            )
        return canonicalize_name(name), version


def _is_candidate_wheel(path: Path, package: str) -> bool:
    """Use the wheel filename to exclude dependency wheels before opening them."""
    try:
        wheel_name, _version, _build, _tags = parse_wheel_filename(path.name)
    except (ValueError, TypeError):
        return False
    return canonicalize_name(wheel_name) == package


def finalize_wheels(package: str, override: str, directory: Path) -> tuple[Path, ...]:
    """Apply the version override to all platform variants of the primary package."""
    if not directory.is_dir():
        raise FinalizeWheelSbomsError(f"wheel directory does not exist: {directory}")
    name = canonicalize_name(package)
    # Filter by the PEP 427 wheel filename first. Dependency wheels must remain
    # completely untouched and may have unusual archive contents; inspect
    # METADATA only for filename-matched primary candidates.
    candidates = [
        path
        for path in sorted(directory.glob("*.whl"))
        if _is_candidate_wheel(path, name)
    ]
    primary = [path for path in candidates if _identity(path) == (name, override)]
    if not primary:
        raise FinalizeWheelSbomsError(f"no wheel matches {package}=={override}")

    for wheel in primary:
        try:
            sync_wheel_sbom(wheel, override)
            removed = prune_wheel_sboms(wheel)
        except (
            OSError,
            zipfile.BadZipFile,
            SyncWheelSbomError,
            PruneWheelSbomError,
        ) as exc:
            raise FinalizeWheelSbomsError(
                f"failed to finalize {wheel.name}: {exc}"
            ) from exc
        for member in removed:
            print(f"Removed non-Red-Hat SBOM from {wheel.name}: {member}")
        if _identity(wheel) != (name, override):
            raise FinalizeWheelSbomsError(
                f"wheel identity changed unexpectedly: {wheel.name}"
            )
        print(f"Synchronized SPDX for {wheel.name}")
    return tuple(primary)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("package")
    parser.add_argument("version")
    parser.add_argument("wheels_dir", type=Path)
    args = parser.parse_args(argv)
    try:
        finalize_wheels(args.package, args.version, args.wheels_dir)
    except (OSError, FinalizeWheelSbomsError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
